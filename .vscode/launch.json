{
  // Workspace root is C:\AIProjects, so the Flutter app lives one folder down.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "JingyaoPaint (Chrome)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/my_paint_app",
      "program": "${workspaceFolder}/my_paint_app/lib/main.dart",
      "deviceId": "chrome"
    },
    {
      "name": "JingyaoPaint (phone / emulator)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/my_paint_app",
      "program": "${workspaceFolder}/my_paint_app/lib/main.dart"
    },
    {
      "name": "JingyaoPaint (Windows)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/my_paint_app",
      "program": "${workspaceFolder}/my_paint_app/lib/main.dart",
      "deviceId": "windows"
    }
  ]
}
